{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grounded explanation; all recommendation and numerical fields belong to the engine",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "strengths", "tradeoffs", "nextStep"],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 900
    },
    "strengths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 350
      }
    },
    "tradeoffs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 350
      }
    },
    "nextStep": {
      "type": "string",
      "maxLength": 450
    }
  }
}
