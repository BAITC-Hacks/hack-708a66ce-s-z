{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qala.local/schemas/decision",
  "title": "QALA policy decision",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["measureId", "districtId"],
      "properties": {
        "measureId": {
          "enum": ["M1", "M3", "M4", "M5", "M7", "M8", "M9", "M10", "M11", "M13"]
        },
        "districtId": {
          "enum": ["esil", "almaty", "saryarka", "baikonur", "nura"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["measureId"],
      "properties": {
        "measureId": {
          "enum": ["M2", "M6", "M12", "M14"]
        }
      }
    }
  ]
}
